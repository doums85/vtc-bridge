# ── Telegram (compte utilisateur) ──────────────────────────────
# Obtiens-les sur https://my.telegram.org  (API development tools)
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef
TG_SESSION=vtc_session

# ── Groupes ────────────────────────────────────────────────────
# ids des groupes VTC (négatifs), séparés par des virgules.
# Pour trouver un id : ajoute @username_to_id_bot ou lis les logs Telethon.
VTC_GROUPS=-1001111111111,-1002222222222
# Groupe privé relais : bot Hermès = admin (privacy OFF) ET où TU partages ta live location.
FEED_GROUP=-1003333333333

# ── Logique ────────────────────────────────────────────────────
THRESHOLD_SECONDS=480          # 8 min
POSITION_STALE_SECONDS=180     # au-delà, la live location est jugée périmée

# ── Services géo ───────────────────────────────────────────────
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Biais géographique "lon_min,lat_max,lon_max,lat_min". Exemple Île-de-France :
GEO_VIEWBOX=1.44,49.24,3.56,48.12
USER_AGENT=vtc-bridge/1.0 (contact: admin@tuumagency.com)

STATE_DIR=state

# Déduplication inter-groupes : une même course repostée ailleurs sous ce délai
# n'est notifiée qu'une fois. L'empreinte principale s'appuie sur les codes postaux.
DEDUP_WINDOW_SECONDS=900
# Repli quand le message n'a ni code postal exploitable ni prix lisible : deux envois
# du même texte sous ce délai comptent pour une seule course. Fenêtre courte à dessein,
# un repost inter-groupes arrive en quelques secondes.
DEDUP_TEXT_WINDOW_SECONDS=120
